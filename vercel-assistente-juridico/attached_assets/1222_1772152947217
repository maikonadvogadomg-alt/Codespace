      td2.appendChild(i2);

      let td3 = document.createElement('td'); td3.className="no-print";
      let btn = document.createElement('button'); btn.textContent="X"; btn.className="btn-del";
      btn.onclick = function() { tr.remove(); recalc(); };
      td3.appendChild(btn);
      
      tr.append(td1, td2, td3);
      tbody.appendChild(tr);
      recalc();
    }

    window.addRenda = () => criarLinha('rend_table', '', '', true);
    window.addDespesa = () => criarLinha('ded_table', '', '', true);
    window.addMembro = () => criarLinha('fam_table', '', '', true);

    // --- CÁLCULO ---
    window.recalc = function() {
      let soma = (id) => {
        let t = 0;
        document.querySelectorAll('#'+id+' tbody input.money').forEach(i => t += lerValor(i.value));
        return t;
      };

      let totRenda = soma('rend_table');
      let totDed = soma('ded_table');
      let totFam = soma('fam_table'); // Informativo
      let membros = document.querySelectorAll('#fam_table tbody tr').length;

      document.getElementById('rend_total').textContent = fmt.format(totRenda);
      document.getElementById('ded_total').textContent = fmt.format(totDed);
      document.getElementById('fam_total').textContent = fmt.format(totFam);
      document.getElementById('fam_count').textContent = membros;

      let liq = Math.max(totRenda - totDed, 0);
      let percapita = membros > 0 ? liq / membros : 0;

      document.getElementById('res_liq').value = fmt.format(liq);
      document.getElementById('res_percapita').value = fmt.format(percapita);
      avaliar(liq, percapita);
    };

    function avaliar(liq, percapita) {
      let limiar = lerValor(document.getElementById('limiar').value);
      let box = document.getElementById('status_msg');
      if (limiar === 0) {
        box.innerHTML = "⚠️ Defina o Limiar acima."; box.style.color="#ccc"; return;
      }
      let base = (document.getElementById('criterio_tipo').value === 'percapita') ? percapita : liq;
      
      if (base <= limiar + 0.01) {
        box.innerHTML = `✅ <b>ELEGÍVEL</b> (${fmt.format(base)} ≤ ${fmt.format(limiar)})`;
        box.style.color="#86efac"; box.style.borderColor="#22c55e";
      } else {
        box.innerHTML = `❌ <b>ACIMA DO LIMITE</b> (Excede ${fmt.format(base - limiar)})`;
        box.style.color="#fca5a5"; box.style.borderColor="#ef4444";
      }
    }

    // --- IMPORTAR / EXPORTAR / SALVAR ---
    
    // Importar CSV
    window.importCSV = function(tipo) {
      let input = document.getElementById('csv_input');
      input.onchange = function() {
        let file = input.files[0];
        if(!file) return;
        let r = new FileReader();
        r.onload = function() {
          let lines = r.result.split(/\r?\n/).filter(l => l.trim().length);
          lines.forEach(l => {
            let c = l.includes(';') ? l.split(';') : l.split(',');
            // Remove aspas
            c = c.map(x => x.replace(/"/g,'').trim());
            // Cria a linha (tabela correta, desc, valor, isMoney)
            if(tipo === 'rend') criarLinha('rend_table', c[0], c[1] || '', true);
            if(tipo === 'ded') criarLinha('ded_table', c[0], c[1] || '', true);
            if(tipo === 'fam') criarLinha('fam_table', c[0], c[1] || '', true);
          });
          input.value = ''; // Reset
          alert('Importado!');
        };
        r.readAsText(file);
      };
      input.click();
    };

    // Exportar JSON
    window.exportJSON = function() {
      let data = {
        meta: { 
          req: document.getElementById('req_nome').value,
          cpf: document.getElementById('req_cpf').value,
          limiar: document.getElementById('limiar').value
        },
        rend: getTableData('rend_table'),
        ded: getTableData('ded_table'),
        fam: getTableData('fam_table')
      };
      let blob = new Blob([JSON.stringify(data,null,2)], {type : 'application/json'});
      let a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'backup_loas.json';
      a.click();
    };

    // Exportar CSV
    window.exportCSVTotal = function() {
      let csv = "TIPO;DESCRICAO;VALOR\n";
      let add = (tbl, tipo) => {
        let rows = getTableData(tbl);
        rows.forEach(r => { csv += `${tipo};${r.col1};${r.col2}\n`; });
      };
      add('rend_table', 'RENDIMENTO');
      add('ded_table', 'DESPESA');
      add('fam_table', 'MEMBRO');
      
      let blob = new Blob([csv], {type: 'text/csv'});
      let a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = 'dados_loas.csv';
      a.click();
    };

    // Salvar Local
    window.saveLocal = function() {
      let data = {
        req: document.getElementById('req_nome').value,
        limiar: document.getElementById('limiar').value,
        html_rend: document.querySelector('#rend_table tbody').innerHTML,
        html_ded: document.querySelector('#ded_table tbody').innerHTML,
        html_fam: document.querySelector('#fam_table tbody').innerHTML,
        // Salvar valores dos inputs pois innerHTML não pega valor digitado
        vals_rend: getTableData('rend_table'),
        vals_ded: getTableData('ded_table'),
        vals_fam: getTableData('fam_table')
      };
      localStorage.setItem('loas_master_save', JSON.stringify(data));
      alert('Rascunho Salvo!');
    };

    window.loadLocal = function() {
      let raw = localStorage.getItem('loas_master_save');
      if(!raw) return alert('Nada salvo');
      let data = JSON.parse(raw);
      
      document.getElementById('req_nome').value = data.req || '';
      document.getElementById('limiar').value = data.limiar || '';
      
      // Reconstrói
      let restore = (tbl, vals) => {
        let tbody = document.querySelector('#'+tbl+' tbody');
        tbody.innerHTML = ''; // Limpa
        vals.forEach(v => criarLinha(tbl, v.col1, v.col2, true));
      };
      
      if(data.vals_rend) restore('rend_table', data.vals_rend);
      if(data.vals_ded) restore('ded_table', data.vals_ded);
      if(data.vals_fam) restore('fam_table', data.vals_fam);
      
      recalc();
    };

    // Helper para pegar dados
    function getTableData(id) {
      let rows = [];
      document.querySelectorAll('#'+id+' tbody tr').forEach(tr => {
        let inputs = tr.querySelectorAll('input');
        rows.push({ col1: inputs[0].value, col2: inputs[1].value });
      });
      return rows;
    }

    // Init
    ativarMascara(document.getElementById('limiar'));
    criarLinha('rend_table','','',true);
    criarLinha('ded_table','','',true);
    criarLinha('fam_table','','',true);

  </script>
</body>
</html>





<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Painel – Flexibilização de Renda</title>
  <style>
    :root{
      --bg:#0f172a; --card:#111827; --ink:#e5e7eb; --muted:#9ca3af; --accent:#22c55e; --warn:#ef4444; --line:#374151;
    }
    *{box-sizing:border-box}
    body{margin:0;background:var(--bg);color:var(--ink);font-family:Inter,system-ui,Segoe UI,Roboto,Arial,sans-serif}
    header{padding:20px;border-bottom:1px solid var(--line);display:flex;align-items:center;gap:12px}
    header h1{font-size:20px;margin:0}
    header small{color:var(--muted)}
    main{padding:20px;display:grid;grid-template-columns:1fr;gap:16px;max-width:1100px;margin:0 auto}
    section{background:var(--card);border:1px solid var(--line);border-radius:12px;padding:16px}
    section h2{margin:0 0 12px;font-size:18px}
    .grid{display:grid;grid-template-columns:repeat(2,1fr);gap:12px}
    .grid-3{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
    label{display:block;font-size:13px;color:var(--muted);margin-bottom:6px}
    input,select,textarea{width:100%;padding:10px;border:1px solid var(--line);border-radius:10px;background:#0b1324;color:var(--ink)}
    textarea{min-height:90px;resize:vertical}
    table{width:100%;border-collapse:collapse;margin-top:10px}
    th,td{border:1px solid var(--line);padding:8px;text-align:left}
    th{background:#0b1324;color:var(--muted);font-weight:600}
    tfoot td{font-weight:700}
    .row-actions{display:flex;gap:8px}
    .btn{padding:8px 12px;border:1px solid var(--line);border-radius:10px;background:#0b1324;color:var(--ink);cursor:pointer}
    .btn:hover{filter:brightness(1.15)}
    .btn-accent{background:var(--accent);color:#062b16;border:none}
    .btn-warn{background:var(--warn);color:#fff;border:none}
    .badge{display:inline-block;padding:6px 10px;border-radius:999px;font-size:12px}
    .ok{background:rgba(34,197,94,.15);color:#86efac;border:1px solid rgba(34,197,94,.35)}
    .no{background:rgba(239,68,68,.15);color:#fecaca;border:1px solid rgba(239,68,68,.35)}
    .toolbar{display:flex;gap:10px;flex-wrap:wrap}
    .muted{color:var(--muted);font-size:12px}
    .flex{display:flex;gap:10px;align-items:center;flex-wrap:wrap}
    .right{margin-left:auto}
    .mono{font-family:ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, "Liberation Mono", monospace}
  </style>
</head>
<body>
  <header>
    <h1>Painel – Flexibilização de Renda</h1>
    <small>Versão inicial (HTML/CSS/JS)</small>
  </header>

  <main>
    <section>
      <h2>Identificação e processo</h2>
      <div class="grid">
        <div>
          <label>Nome do requerente</label>
          <input id="req_nome" placeholder="Nome completo" />
        </div>
        <div>
          <label>CPF</label>
          <input id="req_cpf" class="mono" placeholder="000.000.000-00" />
        </div>
        <div>
          <label>NIS/PIS</label>
          <input id="req_nis" class="mono" placeholder="NIS/PIS" />
        </div>
        <div>
          <label>Nº do processo</label>
          <input id="proc_num" class="mono" placeholder="Ex.: 0001234-56.2025.8.13.0000" />
        </div>
      </div>
      <div style="margin-top:10px">
        <label>Resumo do caso / observações</label>
        <textarea id="proc_obs" placeholder="Contexto, pedidos, decisões, observações relevantes"></textarea>
      </div>
    </section>

    <section>
      <h2>Base legal e artigos aplicáveis</h2>
      <div class="grid-3">
        <div>
          <label>Lei</label>
          <input id="lei_nome" placeholder="Ex.: Lei nº XXXX/2025 – Flexibilização de Renda" />
        </div>
        <div>
          <label>Limiar de renda líquida (critério)</label>
          <input id="limiar" type="number" step="0.01" placeholder="Ex.: 1320.00" />
        </div>
        <div>
          <label>Critério por pessoa (opcional)</label>
          <select id="criterio_tipo">
            <option value="total">Renda líquida total da família</option>
            <option value="percapita">Renda líquida per capita</option>
          </select>
        </div>
      </div>
      <div class="flex" style="margin-top:10px">
        <label style="width:100%">Artigos/Incisos aplicáveis</label>
        <input id="artigos" placeholder="Ex.: Art. 2º, §1º, incisos I, II e IV; Art. 3º, §2º" />
      </div>
      <p class="muted">Dica: edite este campo para listar exatamente os artigos que você quer cumprir e aparecer no relatório.</p>
    </section>

    <section>
      <h2>Rendimentos</h2>
      <div class="toolbar">
        <button class="btn btn-accent" onclick="addRow('rend')">Adicionar rendimento</button>
        <button class="btn" onclick="importCSV('rend')">Importar CSV</button>
      </div>
      <table id="rend_table">
        <thead>
          <tr>
            <th>Fonte</th>
            <th>Descrição</th>
            <th>Periodicidade</th>
            <th>Valor (R$)</th>
            <th>Documento/Comprovante</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody></tbody>
        <tfoot>
          <tr>
            <td colspan="3">Total de rendimentos</td>
            <td id="rend_total" class="mono">0,00</td>
            <td colspan="2"></td>
          </tr>
        </tfoot>
      </table>
    </section>

    <section>
      <h2>Despesas dedutíveis</h2>
      <div class="toolbar">
        <button class="btn btn-accent" onclick="addRow('ded')">Adicionar despesa</button>
        <button class="btn" onclick="importCSV('ded')">Importar CSV</button>
      </div>
      <table id="ded_table">
        <thead>
          <tr>
            <th>Tipo</th>
            <th>Descrição</th>
            <th>Base legal (artigo/inciso)</th>
            <th>Valor (R$)</th>
            <th>Documento</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody></tbody>
        <tfoot>
          <tr>
            <td colspan="3">Total de deduções</td>
            <td id="ded_total" class="mono">0,00</td>
            <td colspan="2"></td>
          </tr>
        </tfoot>
      </table>
    </section>

    <section>
      <h2>Composição familiar</h2>
      <div class="toolbar">
        <button class="btn btn-accent" onclick="addRow('fam')">Adicionar membro</button>
        <button class="btn" onclick="importCSV('fam')">Importar CSV</button>
      </div>
      <table id="fam_table">
        <thead>
          <tr>
            <th>Nome</th>
            <th>Parentesco</th>
            <th>Renda (R$)</th>
            <th>Documento</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody></tbody>
        <tfoot>
          <tr>
            <td colspan="2">Total renda familiar</td>
            <td id="fam_total" class="mono">0,00</td>
            <td colspan="2"></td>
          </tr>
        </tfoot>
      </table>
    </section>

    <section>
      <h2>Eventos do processo</h2>
      <div class="toolbar">
        <button class="btn btn-accent" onclick="addRow('evt')">Adicionar evento</button>
      </div>
      <table id="evt_table">
        <thead>
          <tr>
            <th>Tipo de evento</th>
            <th>Data</th>
            <th>Descrição</th>
            <th>Documento</th>
            <th>Ações</th>
          </tr>
        </thead>
        <tbody></tbody>
      </table>
    </section>

    <section>
      <h2>Cálculo e conformidade</h2>
      <div class="grid">
        <div>
          <label>Renda bruta (automática)</label>
          <input id="calc_renda_bruta" class="mono" readonly />
        </div>
        <div>
          <label>Total deduções (automática)</label>
          <input id="calc_deducoes" class="mono" readonly />
        </div>
        <div>
          <label>Renda líquida</label>
          <input id="calc_renda_liquida" class="mono" readonly />
        </div>
        <div>
          <label>Per capita (se aplicável)</label>
          <input id="calc_percapita" class="mono" readonly />
        </div>
      </div>
      <div class="flex" style="margin-top:10px">
        <span id="conformidade" class="badge no">Critério não avaliado</span>
        <span class="right muted">Ajuste o limiar e o tipo de critério na base legal.</span>
      </div>
      <div class="toolbar" style="margin-top:12px">
        <button class="btn" onclick="saveLocal()">Salvar no navegador</button>
        <button class="btn" onclick="loadLocal()">Carregar</button>
        <button class="btn" onclick="exportJSON()">Exportar JSON</button>
        <button class="btn" onclick="exportCSV()">Exportar CSV</button>
        <button class="btn" onclick="window.print()">Imprimir/Salvar PDF</button>
      </div>
    </section>
  </main>

  <input type="file" id="csv_input" accept=".csv" style="display:none" />

  <script>
    // Helpers
    const fmt = new Intl.NumberFormat('pt-BR',{style:'currency',currency:'BRL'});
    const num = v => {
      const n = parseFloat(String(v).replace(/\./g,'').replace(',','.'));
      return isNaN(n) ? 0 : n;
    };
    const moneyInput = (el)=> el.addEventListener('input',()=>recalc());

    // Dynamic row builders
    function addRow(kind, data={}){
      const map = {
        rend: { table:'rend_table', cols:[
          {key:'fonte',type:'text',ph:'Ex.: Salário, BPC, pensão'},
          {key:'desc',type:'text',ph:'Detalhes'},
          {key:'per', type:'select', opts:['Mensal','Semanal','Anual','Único']},
          {key:'valor',type:'number',ph:'0,00'},
          {key:'doc',  type:'text',ph:'Comprovante/ID'}
        ]},
        ded: { table:'ded_table', cols:[
          {key:'tipo', type:'text',ph:'Ex.: saúde, moradia, transporte'},
          {key:'desc', type:'text',ph:'Detalhes'},
          {key:'base', type:'text',ph:'Art./inciso que autoriza a dedução'},
          {key:'valor',type:'number',ph:'0,00'},
          {key:'doc',  type:'text',ph:'Comprovante/ID'}
        ]},
        fam: { table:'fam_table', cols:[
          {key:'nome', type:'text',ph:'Nome'},
          {key:'parentesco', type:'text',ph:'Ex.: cônjuge, filho'},
          {key:'renda', type:'number',ph:'0,00'},
          {key:'doc',   type:'text',ph:'Documento/ID'}
        ]},
        evt: { table:'evt_table', cols:[
          {key:'tipo', type:'text',ph:'Ex.: petição, decisão, juntada'},
          {key:'data', type:'date'},
          {key:'desc', type:'text',ph:'Resumo do evento'},
          {key:'doc',  type:'text',ph:'Documento/ID'}
        ]}
      };
      const cfg = map[kind];
      const tbody = document.querySelector(`#${cfg.table} tbody`);
      const tr = document.createElement('tr');

      cfg.cols.forEach(c=>{
        const td=document.createElement('td');
        let input;
        if(c.type==='select'){
          input=document.createElement('select');
          c.opts.forEach(o=>{ const op=document.createElement('option'); op.textContent=o; input.appendChild(op); });
        } else {
          input=document.createElement('input');
          input.type=c.type;
          input.placeholder=c.ph||'';
        }
        input.value = data[c.key] ?? '';
        if(['valor','renda'].includes(c.key)) moneyInput(input);
        td.appendChild(input);
        tr.appendChild(td);
      });

      const tdAct=document.createElement('td'); tdAct.className='row-actions';
      const rm=document.createElement('button'); rm.className='btn btn-warn'; rm.textContent='Remover';
      rm.onclick=()=>{ tr.remove(); recalc(); };
      tdAct.appendChild(rm);
      tr.appendChild(tdAct);
      tbody.appendChild(tr);
      recalc();
    }

    // CSV import (simple: comma; header ignored)
    function importCSV(kind){
      const input=document.getElementById('csv_input');
      input.onchange=()=> {
        const file=input.files[0]; if(!file) return;
        const reader=new FileReader();
        reader.onload=()=> {
          const lines=reader.result.split(/\r?\n/).filter(l=>l.trim().length);
          lines.forEach((line,i)=>{
            const cols=line.split(',');
            if(kind==='rend'){
              addRow('rend',{fonte:cols[0],desc:cols[1],per:cols[2]||'Mensal',valor:cols[3],doc:cols[4]});
            } else if(kind==='ded'){
              addRow('ded',{tipo:cols[0],desc:cols[1],base:cols[2],valor:cols[3],doc:cols[4]});
            } else if(kind==='fam'){
              addRow('fam',{nome:cols[0],parentesco:cols[1],renda:cols[2],doc:cols[3]});
            }
          });
          input.value='';
        };
        reader.readAsText(file,'utf-8');
      };
      input.click();
    }

    // Calculations
    function recalc(){
      const sum = (sel, idx) => {
        let total=0;
        document.querySelectorAll(`#${sel} tbody tr`).forEach(tr=>{
          const v = tr.querySelectorAll('td input')[idx]?.value ?? '0';
          total += num(v);
        });
        return total;
      };

      const rendTotal = sum('rend_table',3);
      const dedTotal  = sum('ded_table',3);
      const famTotal  = sum('fam_table',2);

      document.getElementById('rend_total').textContent = fmt.format(rendTotal);
      document.getElementById('ded_total').textContent  = fmt.format(dedTotal);
      document.getElementById('fam_total').textContent  = fmt.format(famTotal);

      const rendaLiquida = Math.max(rendTotal - dedTotal, 0);
      document.getElementById('calc_renda_bruta').value = fmt.format(rendTotal);
      document.getElementById('calc_deducoes').value    = fmt.format(dedTotal);
      document.getElementById('calc_renda_liquida').value = fmt.format(rendaLiquida);

      const percapita = calcPerCapita(rendaLiquida);
      document.getElementById('calc_percapita').value = percapita!=null ? fmt.format(percapita) : '';

      avaliarConformidade(rendaLiquida, percapita);
    }

    function calcPerCapita(rendaLiquida){
      const membros = document.querySelectorAll('#fam_table tbody tr').length;
      if(membros<=0) return null;
      return rendaLiquida / membros;
    }

    function avaliarConformidade(rendaLiquida, percapita){
      const tipo = document.getElementById('criterio_tipo').value;
      const limiar = num(document.getElementById('limiar').value);
      const badge = document.getElementById('conformidade');

      if(!limiar){
        badge.textContent='Defina o limiar para avaliar';
        badge.className='badge no';
        return;
      }

      let valorComparado = rendaLiquida;
      if(tipo==='percapita' && percapita!=null) valorComparado = percapita;

      if(valorComparado <= limiar){
        badge.textContent = `Em conformidade (≤ ${fmt.format(limiar)})`;
        badge.className='badge ok';
      } else {
        badge.textContent = `Não conformidade (> ${fmt.format(limiar)})`;
        badge.className='badge no';
      }
    }

    // Persistence
    function getState(){
      const pickRows = (tableId, keysIdx) => {
        const rows=[];
        document.querySelectorAll(`#${tableId} tbody tr`).forEach(tr=>{
          const inputs=[...tr.querySelectorAll('td input, td select')];
          const row={};
          keysIdx.forEach(([key,idx])=> row[key] = inputs[idx]?.value || '');
          rows.push(row);
        });
        return rows;
      };
      return {
        req_nome: document.getElementById('req_nome').value,
        req_cpf:  document.getElementById('req_cpf').value,
        req_nis:  document.getElementById('req_nis').value,
        proc_num: document.getElementById('proc_num').value,
        proc_obs: document.getElementById('proc_obs').value,
        lei_nome: document.getElementById('lei_nome').value,
        limiar:   document.getElementById('limiar').value,
        criterio_tipo: document.getElementById('criterio_tipo').value,
        artigos:  document.getElementById('artigos').value,
        rend: pickRows('rend_table', [['fonte',0],['desc',1],['per',2],['valor',3],['doc',4]]),
        ded:  pickRows('ded_table',  [['tipo',0],['desc',1],['base',2],['valor',3],['doc',4]]),
        fam:  pickRows('fam_table',  [['nome',0],['parentesco',1],['renda',2],['doc',3]]),
        evt:  pickRows('evt_table',  [['tipo',0],['data',1],['desc',2],['doc',3]])
      };
    }

    function setState(s){
      document.getElementById('req_nome').value = s.req_nome||'';
      document.getElementById('req_cpf').value  = s.req_cpf||'';
      document.getElementById('req_nis').value  = s.req_nis||'';
      document.getElementById('proc_num').value = s.proc_num||'';
      document.getElementById('proc_obs').value = s.proc_obs||'';
      document.getElementById('lei_nome').value = s.lei_nome||'';
      document.getElementById('limiar').value   = s.limiar||'';
      document.getElementById('criterio_tipo').value = s.criterio_tipo||'total';
      document.getElementById('artigos').value  = s.artigos||'';

      ['rend','ded','fam','evt'].forEach(k=>{
        const tbody=document.querySelector(`#${k}_table tbody`);
        tbody.innerHTML='';
        (s[k]||[]).forEach(row=> addRow(k,row));
      });
      recalc();
    }

    function saveLocal(){
      localStorage.setItem('painel_flex_renda', JSON.stringify(getState()));
      alert('Salvo no navegador!');
    }
    function loadLocal(){
      const raw=localStorage.getItem('painel_flex_renda');
      if(!raw) return alert('Nada salvo.');
      setState(JSON.parse(raw));
    }
    function exportJSON(){
      const blob=new Blob([JSON.stringify(getState(),null,2)],{type:'application/json'});
      const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download='painel-flex-renda.json'; a.click();
    }
    function exportCSV(){
      const s=getState();
      const toCSV=(rows,header)=> [header.join(','), ...rows.map(r=> header.map(h=> (r[h]||'').toString().replace(/,/g,';')).join(','))].join('\n');
      const files = [
        ['rendimentos.csv', toCSV(s.rend, ['fonte','desc','per','valor','doc'])],
        ['deducoes.csv',   toCSV(s.ded,  ['tipo','desc','base','valor','doc'])],
        ['familia.csv',    toCSV(s.fam,  ['nome','parentesco','renda','doc'])],
        ['eventos.csv',    toCSV(s.evt,  ['tipo','data','desc','doc'])],
      ];
      files.forEach(([name,data])=>{
        const blob=new Blob([data],{type:'text/csv;charset=utf-8'});
        const a=document.createElement('a'); a.href=URL.createObjectURL(blob); a.download=name; a.click();
      });
    }

    // Seed rows to start
    addRow('rend'); addRow('ded'); addRow('fam'); addRow('evt');
  </script>
</body>
</html>


