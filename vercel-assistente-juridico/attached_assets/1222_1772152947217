  <input type="file" id="csv_input" accept=".csv" style="display:none" />

  <script>
    // --- LÓGICA DE TRATAMENTO DE DINHEIRO (BRASIL) ---

    const fmtMoeda = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });

    /**
     * Converte uma string formatada (R$ 1.500,50) para Float JS (1500.50)
     * para podermos somar e subtrair corretamente.
     */
    function lerMoeda(val) {
      if (!val) return 0;
      // Remove R$, espaços e pontos de milhar (deixa apenas números e vírgula)
      let limpo = val.toString().replace(/[^\d,]/g, ''); 
      // Troca vírgula por ponto para o JS entender
      limpo = limpo.replace(',', '.');
      return parseFloat(limpo) || 0;
    }

    /**
     * Aplica a máscara ENQUANTO você digita.
     * Transforma 1500 em R$ 15,00.
     * Transforma 150050 em R$ 1.500,50.
     */
    function aplicarMascara(input) {
      input.addEventListener('input', (e) => {
        let valor = e.target.value.replace(/\D/g, ''); // Remove tudo que não é número
        
        if (valor === '') {
          e.target.value = '';
          recalc();
          return;
        }

        // Divide por 100 para ter os centavos
        valor = (parseInt(valor) / 100).toFixed(2) + '';
        
        // Troca ponto por virgula
        valor = valor.replace('.', ',');
        
        // Adiciona ponto de milhar (Regex complexo padrão para dinheiro)
        valor = valor.replace(/\B(?=(\d{3})+(?!\d))/g, ".");
        
        e.target.value = 'R$ ' + valor;
        recalc();
      });
    }

    // --- CONSTRUÇÃO DAS TABELAS ---

    function addRow(kind, data={}) {
      const map = {
        rend: { table: 'rend_table', cols: [
          { key:'fonte', type:'text', ph:'Ex: Bolsa Família, Bico' },
          { key:'desc', type:'text', ph:'Detalhes' },
          { key:'per', type:'select', opts:['Mensal','Eventual','Anual'] },
          { key:'valor', type:'text', ph:'R$ 0,00', isMoney:true }, // Marcado como dinheiro
          { key:'doc', type:'text', ph:'ID/Página' }
        ]},
        ded: { table: 'ded_table', cols: [
          { key:'tipo', type:'text', ph:'Ex: Remédios, Fraldas' },
          { key:'desc', type:'text', ph:'Nome do medicamento/insumo' },
          { key:'base', type:'text', ph:'Artigo/Lei' },
          { key:'valor', type:'text', ph:'R$ 0,00', isMoney:true }, // Marcado como dinheiro
          { key:'doc', type:'text', ph:'Recibos/ID' }
        ]},
        fam: { table: 'fam_table', cols: [
          { key:'nome', type:'text', ph:'Nome Completo' },
          { key:'parentesco', type:'text', ph:'Ex: Filho, Neto' },
          { key:'renda', type:'text', ph:'R$ 0,00', isMoney:true }, // Apenas informativo aqui
          { key:'doc', type:'text', ph:'CPF' }
        ]},
        evt: { table: 'evt_table', cols: [
          { key:'tipo', type:'text', ph:'Ex: Perícia Médica' },
          { key:'data', type:'date' },
          { key:'desc', type:'text', ph:'Resultado/Obs' },
          { key:'doc', type:'text', ph:'ID' }
        ]}
      };

      const cfg = map[kind];
      const tbody = document.querySelector(`#${cfg.table} tbody`);
      const tr = document.createElement('tr');

      cfg.cols.forEach(c => {
        const td = document.createElement('td');
        let input;
        
        if (c.type === 'select') {
          input = document.createElement('select');
          c.opts.forEach(o => {
            const op = document.createElement('option');
            op.textContent = o;
            input.appendChild(op);
          });
        } else {
          input = document.createElement('input');
          input.type = c.type;
          input.placeholder = c.ph || '';
        }
        
        // Se for campo de dinheiro, adiciona classe visual e máscara lógica
        if (c.isMoney) {
          input.classList.add('input-money');
          aplicarMascara(input);
        }

        // Se veio dados (do CSV ou Save), preenche
        input.value = data[c.key] ?? '';
        
        td.appendChild(input);
        tr.appendChild(td);
      });

      // Botão Excluir
      const tdAct = document.createElement('td');
      tdAct.className = 'no-print';
      const btn = document.createElement('button');
      btn.className = 'btn btn-warn';
      btn.textContent = 'Excluir';
      btn.onclick = () => { tr.remove(); recalc(); };
      
      tdAct.appendChild(btn);
      tr.appendChild(tdAct);
      tbody.appendChild(tr);

      recalc();
    }

    // --- CÁLCULO INTELIGENTE ---

    function recalc() {
      // Helper para somar coluna específica de uma tabela
      const somarTabela = (idTabela, indiceColuna) => {
        let total = 0;
        document.querySelectorAll(`#${idTabela} tbody tr`).forEach(tr => {
          const inputs = tr.querySelectorAll('td input');
          // Proteção para não pegar índice errado
          if(inputs[indiceColuna]) {
            total += lerMoeda(inputs[indiceColuna].value);
          }
        });
        return total;
      };

      // Índices (baseado na ordem das colunas em addRow):
      // Renda: Valor é o 4º campo (index 3)
      // Dedução: Valor é o 4º campo (index 3)
      // Família: Renda é o 3º campo (index 2)
      
      const totalRenda = somarTabela('rend_table', 3);
      const totalDed = somarTabela('ded_table', 3);
      const totalFamRenda = somarTabela('fam_table', 2);
      
      const numMembros = document.querySelectorAll('#fam_table tbody tr').length;

      // Exibir totais parciais
      document.getElementById('rend_total').textContent = fmtMoeda.format(totalRenda);
      document.getElementById('ded_total').textContent = fmtMoeda.format(totalDed);
      document.getElementById('fam_total').textContent = fmtMoeda.format(totalFamRenda);
      document.getElementById('fam_count').textContent = numMembros;

