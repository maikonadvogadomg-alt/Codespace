<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Painel LOAS - Visual Law</title>
  <style>
    /* --- ESTILO DARK JURÍDICO (O BONITO) --- */
    :root {
      --bg: #1b2b1b;       /* Fundo Escuro */
      --card: #243624;     /* Cartões */
      --input: #111b11;    /* Fundo do Input */
      --text: #e5e7eb;     /* Texto Claro */
      --accent: #2e8b57;   /* Verde Botão */
      --warn: #ef4444;     /* Vermelho */
      --line: #3a4a3a;     /* Linhas */
    }

    body { margin: 0; background: var(--bg); color: var(--text); font-family: 'Segoe UI', sans-serif; padding: 10px; }

    /* Layout dos Cartões */
    section {
      background: var(--card);
      border: 1px solid var(--line);
      border-radius: 8px;
      padding: 15px;
      margin-bottom: 15px;
      box-shadow: 0 4px 6px rgba(0,0,0,0.3);
    }

    h2 {
      margin-top: 0;
      color: var(--accent);
      border-bottom: 1px solid var(--line);
      padding-bottom: 8px;
      font-size: 16px;
      text-transform: uppercase;
    }

    /* Inputs e Labels */
    label { display: block; color: #9ca3af; font-size: 12px; margin-top: 8px; margin-bottom: 2px; }
    
    input, select, textarea {
      width: 100%;
      background: var(--input);
      border: 1px solid var(--line);
      color: var(--text);
      padding: 10px;
      border-radius: 5px;
      outline: none;
      box-sizing: border-box; /* Importante para não quebrar no celular */
    }
    input:focus { border-color: var(--accent); }

    /* Botões (Grandes para funcionar no toque) */
    .toolbar { margin-bottom: 10px; }
    button {
      padding: 10px 15px;
      border-radius: 5px;
      cursor: pointer;
      font-weight: bold;
      border: none;
      color: white;
      margin-right: 5px;
      margin-bottom: 5px;
    }
    .btn-add { background: var(--accent); }
    .btn-del { background: var(--warn); padding: 5px 10px; font-size: 12px; }
    .btn-print { background: #333; border: 1px solid #555; }

    /* Tabelas */
    table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
    th { background: #152015; color: #9ca3af; text-align: left; padding: 8px; border: 1px solid var(--line); }
    td { border: 1px solid var(--line); padding: 5px; }
    
    /* Inputs dentro da tabela parecem texto puro */
    td input { border: none; background: transparent; padding: 5px; margin: 0; }

    /* Estilos Especiais */
    .money { text-align: right; color: #86efac; font-weight: bold; }
    .res-box { background: #152015; padding: 10px; border-radius: 5px; margin-top: 5px; }
    
    /* IMPRESSÃO (FICA BRANCO NO PAPEL) */
    @media print {
      body { background: white; color: black; }
      section { background: white; border: 1px solid #000; box-shadow: none; }
      input, select, textarea { background: white; color: black; border: none; }
      th { background: #eee; color: black; border: 1px solid #000; }
      td { border: 1px solid #000; }
      button, .no-print { display: none !important; }
      h2 { color: black; border-bottom: 2px solid black; }
      .money { color: black; }
    }
  </style>
</head>
<body>

  <header style="text-align:center; margin-bottom:20px;">
    <h1 style="color:white; margin:0;">Painel de Análise LOAS</h1>
    <small style="color:#9ca3af;">Lei 14.176/21 e Portaria Conjunta nº 34/2025</small>
  </header>

  <section>
    <h2>1. Identificação</h2>
    <label>Nome do Cliente</label>
    <input id="req_nome" placeholder="Nome Completo">
    
    <div style="display:flex; gap:10px;">
      <div style="flex:1"><label>CPF</label><input id="req_cpf"></div>
      <div style="flex:1"><label>Processo nº</label><input id="proc_num"></div>
    </div>

    <label>Resumo dos Fatos (Falta de Perícia / Agravamento)</label>
    <textarea id="proc_obs" placeholder="Ex: Negativa administrativa sem análise biopsicossocial..."></textarea>
  </section>

  <section>
    <h2>2. Parâmetros Legais</h2>
    <div style="display:flex; gap:10px; flex-wrap:wrap;">
      <div style="flex:1; min-width:150px;">
        <label>Limiar (Ex: R$ 353,00)</label>
        <input id="limiar" class="money" placeholder="R$ 0,00" type="tel">
      </div>
      <div style="flex:1; min-width:150px;">
        <label>Critério</label>
        <select id="criterio_tipo" onchange="recalc()">
          <option value="percapita">Renda Per Capita</option>
          <option value="total">Renda Total</option>
        </select>
      </div>
    </div>
  </section>

  <section>
    <h2>3. Rendimentos (Família)</h2>
    <div class="toolbar no-print">
      <button class="btn-add" onclick="addRenda()">+ Adicionar Renda</button>
    </div>
    <table id="rend_table">
      <thead><tr><th>Origem / Descrição</th><th width="30%">Valor (R$)</th><th width="40" class="no-print"></th></tr></thead>
      <tbody></tbody>
      <tfoot><tr><td>TOTAL BRUTO</td><td id="rend_total" class="money">R$ 0,00</td><td></td></tr></tfoot>
    </table>
  </section>

  <section>
    <h2>4. Despesas (Portaria 34)</h2>
    <div class="toolbar no-print">
      <button class="btn-add" onclick="addDespesa()">+ Adicionar Despesa</button>
    </div>
    <table id="ded_table">
      <thead><tr><th>Descrição (Remédio/Fralda)</th><th width="30%">Valor (R$)</th><th width="40" class="no-print"></th></tr></thead>
      <tbody></tbody>
      <tfoot><tr><td>TOTAL DEDUÇÕES</td><td id="ded_total" class="money" style="color:#fca5a5">R$ 0,00</td><td></td></tr></tfoot>
    </table>
  </section>

  <section>
    <h2>5. Composição Familiar</h2>
    <div class="toolbar no-print">
      <button class="btn-add" onclick="addMembro()">+ Adicionar Membro</button>
    </div>
    <table id="fam_table">
      <thead><tr><th>Nome / Parentesco</th><th width="30%">Renda (Info)</th><th width="40" class="no-print"></th></tr></thead>
      <tbody></tbody>
      <tfoot><tr><td>Membros: <span id="fam_count">0</span></td><td id="fam_total">R$ 0,00</td><td></td></tr></tfoot>
    </table>
  </section>

  <section>
    <h2>Resultado do Cálculo</h2>
    
    <label>Renda Líquida (Bruto - Deduções)</label>
    <input id="res_liq" readonly style="font-weight:bold; color:var(--accent); font-size:16px;">
    
    <label>Renda Per Capita Final</label>
    <div class="res-box">
      <input id="res_percapita" readonly style="font-weight:bold; font-size:20px; text-align:center; border:none; background:transparent;">
    </div>
    
    <div id="status_msg" style="text-align:center; margin-top:15px; padding:10px; border:1px dashed #555; border-radius:10px; font-size:14px;">
      Aguardando dados...
    </div>

    <div class="no-print" style="margin-top:20px; text-align:right;">
      <button class="btn-print" onclick="window.print()">🖨️ Imprimir / PDF</button>
    </div>
  </section>

  <script>
    // --- MOTOR ROBUSTO (FUNCIONA NO CELULAR) ---

    // 1. Formatação de Dinheiro
    const fmt = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });

    function lerValor(val) {
      if (!val) return 0;
      let v = val.toString().replace(/[^\d,]/g, '').replace(',', '.');
      return parseFloat(v) || 0;
    }

    // 2. Máscara Automática (Digita 100 vira R$ 1,00)
    function ativarMascara(input) {
      input.addEventListener('input', function(e) {
        let v = e.target.value.replace(/\D/g, '');
        if (v === '') { e.target.value = ''; recalc(); return; }
        v = (parseInt(v) / 100).toFixed(2) + '';
        v = v.replace('.', ',');
        v = v.replace(/\B(?=(\d{3})+(?!\d))/g, ".");
        e.target.value = 'R$ ' + v;
        recalc();
      });
    }

    // 3. Funções de Adicionar Linha (Separadas para não travar)
    
    function criarInputTexto(ph) {
      let i = document.createElement('input');
      i.placeholder = ph;
      return i;
    }

    function criarInputDinheiro() {
      let i = document.createElement('input');
      i.placeholder = "R$ 0,00";
      i.className = "money";
      i.type = "tel"; // Teclado numérico no celular
      ativarMascara(i);
      return i;
    }

    function criarBotaoExcluir(tr) {
      let btn = document.createElement('button');
      btn.textContent = "X";
      btn.className = "btn-del";
      btn.onclick = function() { tr.remove(); recalc(); };
      return btn;
    }

    // Adiciona Renda
    window.addRenda = function() {
      let tbody = document.querySelector('#rend_table tbody');
      let tr = document.createElement('tr');
      
      let td1 = document.createElement('td'); td1.appendChild(criarInputTexto("Ex: Bico, Bolsa Família"));
      let td2 = document.createElement('td'); td2.appendChild(criarInputDinheiro());
      let td3 = document.createElement('td'); td3.className="no-print"; td3.appendChild(criarBotaoExcluir(tr));
      
      tr.append(td1, td2, td3);
      tbody.appendChild(tr);
    };

    // Adiciona Despesa
    window.addDespesa = function() {
      let tbody = document.querySelector('#ded_table tbody');
      let tr = document.createElement('tr');
      
      let td1 = document.createElement('td'); td1.appendChild(criarInputTexto("Ex: Fraldas (Portaria 34)"));
      let td2 = document.createElement('td'); td2.appendChild(criarInputDinheiro());
      let td3 = document.createElement('td'); td3.className="no-print"; td3.appendChild(criarBotaoExcluir(tr));
      
      tr.append(td1, td2, td3);
      tbody.appendChild(tr);
    };

    // Adiciona Membro
    window.addMembro = function() {
      let tbody = document.querySelector('#fam_table tbody');
      let tr = document.createElement('tr');
      
      let td1 = document.createElement('td'); td1.appendChild(criarInputTexto("Nome / Parentesco"));
      let td2 = document.createElement('td'); td2.appendChild(criarInputDinheiro()); // Renda informativa
      let td3 = document.createElement('td'); td3.className="no-print"; td3.appendChild(criarBotaoExcluir(tr));
      
      tr.append(td1, td2, td3);
      tbody.appendChild(tr);
      recalc(); // Atualiza contagem
    };

    // 4. Cálculo Geral
    window.recalc = function() {
      // Soma Renda
      let totRenda = 0;
      document.querySelectorAll('#rend_table tbody input.money').forEach(i => totRenda += lerValor(i.value));
      
      // Soma Despesa
      let totDed = 0;
      document.querySelectorAll('#ded_table tbody input.money').forEach(i => totDed += lerValor(i.value));
      
      // Soma Família (Info)
      let totFam = 0;
      document.querySelectorAll('#fam_table tbody input.money').forEach(i => totFam += lerValor(i.value));
      
      // Conta Membros
      let membros = document.querySelectorAll('#fam_table tbody tr').length;

      // Exibe Totais
      document.getElementById('rend_total').textContent = fmt.format(totRenda);
      document.getElementById('ded_total').textContent = fmt.format(totDed);
      document.getElementById('fam_total').textContent = fmt.format(totFam);
      document.getElementById('fam_count').textContent = membros;

      // Líquido
      let liquido = Math.max(totRenda - totDed, 0);
      document.getElementById('res_liq').value = fmt.format(liquido);

      // Per Capita
      let percapita = 0;
      if (membros > 0) percapita = liquido / membros;
      document.getElementById('res_percapita').value = fmt.format(percapita);

      avaliar(liquido, percapita);
    };

    function avaliar(liq, percapita) {
      let limiar = lerValor(document.getElementById('limiar').value);
      let tipo = document.getElementById('criterio_tipo').value;
      let box = document.getElementById('status_msg');

      if (limiar === 0) {
        box.textContent = "⚠️ Defina o valor do Limiar no topo para ver o resultado.";
        box.style.color = "#ccc";
        box.style.borderColor = "#555";
        return;
      }

      let comparado = (tipo === 'percapita') ? percapita : liq;

      if (comparado <= limiar + 0.01) {
        box.innerHTML = `✅ <b>ELEGÍVEL!</b><br>Renda (${fmt.format(comparado)}) está dentro do limite de ${fmt.format(limiar)}.`;
        box.style.color = "#86efac";
        box.style.borderColor = "#22c55e";
        box.style.background = "rgba(34,197,94,0.1)";
      } else {
        let dif = comparado - limiar;
        box.innerHTML = `❌ <b>ACIMA DO LIMITE</b><br>Ultrapassa em ${fmt.format(dif)}. Tente rever as despesas da Portaria 34.`;
        box.style.color = "#fca5a5";
        box.style.borderColor = "#ef4444";
        box.style.background = "rgba(239,68,68,0.1)";
      }
    }

    // Inicializa
    ativarMascara(document.getElementById('limiar'));
    addRenda();
    addDespesa();
    addMembro();

  </script>
</body>
</html>




<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Painel LOAS - Universal</title>
  <style>
    /* ESTILO LIMPO E COMPATÍVEL */
    :root {
      --bg: #1b2b1b;
      --card: #243624;
      --text: #e5e7eb;
      --accent: #2e8b57;
      --warn: #ef4444;
      --line: #3a4a3a;
    }
    body { background: var(--bg); color: var(--text); font-family: sans-serif; margin: 0; padding: 10px; }
    
    header, section { background: var(--card); border: 1px solid var(--line); margin-bottom: 15px; padding: 15px; border-radius: 8px; }
    h1 { font-size: 18px; margin: 0 0 5px 0; color: #fff; }
    h2 { font-size: 16px; color: var(--accent); border-bottom: 1px solid var(--line); padding-bottom: 5px; margin-top: 0; }
    
    label { display: block; font-size: 12px; color: #ccc; margin-top: 10px; }
    input, select, textarea { width: 100%; padding: 8px; margin-top: 5px; background: #111; border: 1px solid #444; color: #fff; border-radius: 4px; box-sizing: border-box; }
    
    /* Botões Grandes para facilitar o toque */
    button { padding: 10px 15px; background: #333; color: #fff; border: 1px solid #555; border-radius: 6px; margin-right: 5px; margin-bottom: 5px; cursor: pointer; }
    .btn-green { background: var(--accent); border-color: #1e5e3a; font-weight: bold; }
    .btn-red { background: var(--warn); border-color: #b91c1c; }
    
    table { width: 100%; border-collapse: collapse; margin-top: 10px; font-size: 13px; }
    th, td { border: 1px solid #444; padding: 8px; text-align: left; }
    th { background: #152015; }
    
    .money { color: #86efac; text-align: right; font-weight: bold; }
    .status-box { padding: 15px; border: 1px dashed #666; text-align: center; margin-top: 15px; border-radius: 8px; }

    @media print {
      body, section, header { background: #fff; color: #000; border: none; }
      button, .no-print { display: none; }
      input, textarea, select { border: 1px solid #ccc; color: #000; background: #fff; }
    }
  </style>
</head>
<body>

  <header>
    <h1>Painel LOAS (Modo Seguro)</h1>
    <small>Compatível com Lei 14.176 e Portaria 34</small>
  </header>

  <main>
    <section>
      <h2>1. Dados do Caso</h2>
      <label>Nome do Cliente</label><input id="req_nome">
      <label>Resumo dos Fatos</label><textarea id="proc_obs" placeholder="Descreva a situação..."></textarea>
    </section>

    <section>
      <h2>2. Parâmetros Legais</h2>
      <label>Limiar de Renda (Ex: R$ 353,00)</label>
      <input id="limiar" class="money" placeholder="R$ 0,00" type="tel">
      
      <label>Critério</label>
      <select id="criterio_tipo" onchange="recalc()">
        <option value="percapita">Renda Per Capita (Por Pessoa)</option>
        <option value="total">Renda Total</option>
      </select>
    </section>

    <section>
      <h2>3. Rendimentos</h2>
      <div class="no-print">
        <button class="btn-green" type="button" onclick="adicionarLinha('rend')">+ Adicionar Renda</button>
      </div>
      <table id="rend_table">
        <thead><tr><th>Descrição</th><th>Valor (R$)</th><th width="40" class="no-print">X</th></tr></thead>
        <tbody></tbody>
        <tfoot><tr><td>TOTAL</td><td id="rend_total">R$ 0,00</td><td></td></tr></tfoot>
      </table>
    </section>

    <section>
      <h2>4. Despesas (Portaria 34)</h2>
      <div class="no-print">
        <button class="btn-green" type="button" onclick="adicionarLinha('ded')">+ Adicionar Despesa</button>
      </div>
      <table id="ded_table">
        <thead><tr><th>Descrição (Ex: Remédios)</th><th>Valor (R$)</th><th width="40" class="no-print">X</th></tr></thead>
        <tbody></tbody>
        <tfoot><tr><td>TOTAL</td><td id="ded_total" style="color:#fca5a5">R$ 0,00</td><td></td></tr></tfoot>
      </table>
    </section>

    <section>
      <h2>5. Família</h2>
      <div class="no-print">
        <button class="btn-green" type="button" onclick="adicionarLinha('fam')">+ Adicionar Membro</button>
      </div>
      <table id="fam_table">
        <thead><tr><th>Nome / Parentesco</th><th>Renda Própria</th><th width="40" class="no-print">X</th></tr></thead>
        <tbody></tbody>
        <tfoot><tr><td>Membros: <span id="fam_count">0</span></td><td id="fam_total">R$ 0,00</td><td></td></tr></tfoot>
      </table>
    </section>

    <section>
      <h2>Resultado</h2>
      <label>Renda Líquida Final</label>
      <input id="res_liq" readonly style="font-weight:bold; color:var(--accent); font-size:16px;">
      
      <label>Renda Per Capita Apurada</label>
      <input id="res_percapita" readonly style="font-weight:bold; background:#222;">
      
      <div class="status-box" id="status_box">
        Defina o Limiar acima para calcular.
      </div>

      <div class="no-print" style="margin-top:20px; text-align:right">
        <button onclick="window.print()">Imprimir PDF</button>
      </div>
    </section>
  </main>

  <script>
    // --- FUNÇÕES GLOBAIS SEGURAS ---

    // Função para formatar moeda
    function formatarMoeda(valor) {
      return valor.toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
    }

    // Função para ler valor do input (converte R$ 1.000,00 para 1000.00)
    function lerValor(input) {
      if(!input || !input.value) return 0;
      var limpo = input.value.replace(/[^\d,]/g, '').replace(',', '.');
      return parseFloat(limpo) || 0;
    }

    // Máscara de dinheiro simples e robusta
    function aplicarMascara(input) {
      input.onkeyup = function() {
        var v = input.value.replace(/\D/g, '');
        v = (parseInt(v) / 100).toFixed(2) + '';
        v = v.replace('.', ',');
        v = v.replace(/\B(?=(\d{3})+(?!\d))/g, ".");
        input.value = 'R$ ' + v;
        recalc();
      };
    }

    // Função Principal de Adicionar Linha (Sem arrow functions)
    window.adicionarLinha = function(tipo) {
      try {
        var tabelaId = tipo + '_table';
        var tbody = document.getElementById(tabelaId).getElementsByTagName('tbody')[0];
        var tr = document.createElement('tr');

        // Coluna 1: Descrição
        var td1 = document.createElement('td');
        var input1 = document.createElement('input');
        input1.placeholder = "Descrição";
        td1.appendChild(input1);
        tr.appendChild(td1);

        // Coluna 2: Valor
        var td2 = document.createElement('td');
        var input2 = document.createElement('input');
        input2.placeholder = "R$ 0,00";
        input2.className = "money";
        input2.type = "tel"; // Abre teclado numérico no celular
        aplicarMascara(input2);
        td2.appendChild(input2);
        tr.appendChild(td2);

        // Coluna 3: Excluir
        var td3 = document.createElement('td');
        td3.className = "no-print";
        var btn = document.createElement('button');
        btn.innerHTML = "X";
        btn.className = "btn-red";
        btn.onclick = function() {
          tr.parentNode.removeChild(tr);
          recalc();
        };
        td3.appendChild(btn);
        tr.appendChild(td3);

        tbody.appendChild(tr);
        recalc(); // Recalcula ao adicionar
      } catch (e) {
        alert("Erro ao adicionar: " + e.message);
      }
    };

    // Função de Cálculo
    window.recalc = function() {
      try {
        var totalRend = somarColuna('rend_table');
        var totalDed = somarColuna('ded_table');
        var totalFam = somarColuna('fam_table');
        
        // Conta membros (linhas da tabela família)
        var numMembros = document.getElementById('fam_table').getElementsByTagName('tbody')[0].rows.length;

        // Atualiza textos
        document.getElementById('rend_total').innerHTML = formatarMoeda(totalRend);
        document.getElementById('ded_total').innerHTML = formatarMoeda(totalDed);
        document.getElementById('fam_total').innerHTML = formatarMoeda(totalFam);
        document.getElementById('fam_count').innerHTML = numMembros;

        // Conta Final
        var liquido = totalRend - totalDed;
        if(liquido < 0) liquido = 0;

        var percapita = 0;
        if(numMembros > 0) percapita = liquido / numMembros;

        document.getElementById('res_liq').value = formatarMoeda(liquido);
        document.getElementById('res_percapita').value = formatarMoeda(percapita);

        avaliar(liquido, percapita);

      } catch (e) {
        console.log("Erro calc: " + e);
      }
    };

    function somarColuna(tabelaId) {
      var total = 0;
      var inputs = document.querySelectorAll('#' + tabelaId + ' tbody input.money');
      for (var i = 0; i < inputs.length; i++) {
        total += lerValor(inputs[i]);
      }
      return total;
    }

    function avaliar(liquido, percapita) {
      var inputLimiar = document.getElementById('limiar');
      var limiar = lerValor(inputLimiar);
      var statusBox = document.getElementById('status_box');
      
      if (limiar === 0) {
        statusBox.innerHTML = "Informe o valor do Limiar acima.";
        statusBox.style.borderColor = "#666";
        statusBox.style.color = "#ccc";
        return;
      }

      var criterio = document.getElementById('criterio_tipo').value;
      var valorBase = (criterio === 'percapita') ? percapita : liquido;

      // Comparação com margem de 1 centavo
      if (valorBase <= limiar + 0.01) {
        statusBox.innerHTML = "✅ <b>ELEGÍVEL</b><br>Renda dentro do limite.";
        statusBox.style.borderColor = "#22c55e";
        statusBox.style.color = "#86efac";
      } else {
        var exc = valorBase - limiar;
        statusBox.innerHTML = "⚠️ <b>ACIMA DO LIMITE</b><br>Ultrapassa em " + formatarMoeda(exc);
        statusBox.style.borderColor = "#ef4444";
        statusBox.style.color = "#fca5a5";
      }
    }

    // Inicializa máscara do Limiar
    aplicarMascara(document.getElementById('limiar'));

    // Adiciona linhas iniciais
    adicionarLinha('rend');
    adicionarLinha('ded');
    adicionarLinha('fam');

  </script>
</body>
